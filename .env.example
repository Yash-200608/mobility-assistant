# AI Mobility Assistant — API Keys
# Copy this file to .env and fill in your keys

GROQ_API_KEY=your_groq_api_key_here
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: override defaults
ROBOFLOW_MODEL=coco/13
# Find voice IDs at: https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
LOCAL_MODEL_WEIGHTS=yolov8s.pt

# Emergency SMS (Twilio). Required for SOS; without these SOS reports a failure.
TWILIO_SID=your_twilio_account_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1xxxxxxxxxx
EMERGENCY_PHONE=+xxxxxxxxxxxx

# Safety behaviour (see README "Safety features")
# Automatic SOS after a confirmed fall. Leave false until the false-alarm rate is measured.
FALL_AUTO_SOS=false
FALL_ESCALATION_SEC=20
# Record the raw Arduino stream for offline replay (tools/replay_trace.py)
# SENSOR_RECORD_PATH=session.jsonl
